# Copy to .env and fill in once the Supabase project is approved and created.
# While these are empty the app runs against browser-local storage instead.
#
# Both values below are PUBLIC — Vite inlines any VITE_-prefixed variable into
# the JavaScript bundle that ships to the browser. The anon key is designed for
# that. The service_role key is NOT: it bypasses Row Level Security entirely.
# Never put service_role in this file or any VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
